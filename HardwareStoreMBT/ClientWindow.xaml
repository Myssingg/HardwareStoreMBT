<Window x:Class="HardwareStoreMBT.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Личный кабинет" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <TabControl BorderBrush="{StaticResource PrimaryPurple}">
            <TabItem Header="Каталог">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="txtSearch" 
                                 Width="200" 
                                 ToolTip="Поиск"
                                 VerticalContentAlignment="Center" />
                        <ComboBox x:Name="cmbCategory" 
                                  Width="150" 
                                  Margin="10,0,0,0" 
                                  DisplayMemberPath="name" 
                                  SelectedValuePath="id"
                                  VerticalContentAlignment="Center"
                                  Height="35"/>
                        <Button Content="Найти" 
                                Width="80" 
                                Click="btnSearch_Click"
                                VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" x:Name="tbCart" Text="Корзина пуста" Margin="0,5" Foreground="{StaticResource PrimaryPurple}"/>
                    <DataGrid Grid.Row="2" x:Name="dgProducts" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding name}" Width="*"/>
                            <DataGridTextColumn Header="Модель" Binding="{Binding model}" Width="150"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding price, StringFormat={}{0:C}}" Width="100"/>
                            <DataGridTextColumn Header="Остаток" Binding="{Binding stock}" Width="80"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding categories.name}" Width="*"/>
                            <DataGridTemplateColumn Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="В корзину" Click="btnAddCart_Click" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Корзина" Click="btnCart_Click"/>
                        <Button Content="Очистить корзину" Click="btnClearCart_Click"/>
                        <Button Content="Оформить заказ" Click="btnOrder_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Мои заказы">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="dgOrders" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding id}" Width="50"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding orderDateTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="130"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding summ, StringFormat={}{0:C}}" Width="100"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding orderStatuses.name}" Width="*"/>
                            <DataGridTextColumn Header="Оплата" Binding="{Binding paymentStatuses.name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="1" Content="Обновить" HorizontalAlignment="Left" Click="btnRefreshOrders_Click"/>
                </Grid>
            </TabItem>
            <TabItem Header="Профиль">
                <StackPanel Margin="10" Width="300" HorizontalAlignment="Left">
                    <TextBlock Text="Фамилия"/>
                    <TextBox x:Name="txtSurname"/>
                    <TextBlock Text="Имя" Margin="0,5,0,0"/>
                    <TextBox x:Name="txtName"/>
                    <TextBlock Text="Отчество" Margin="0,5,0,0"/>
                    <TextBox x:Name="txtPatronymic"/>
                    <TextBlock Text="Телефон" Margin="0,5,0,0"/>
                    <TextBox x:Name="txtPhone"/>
                    <TextBlock Text="Email" Margin="0,5,0,0"/>
                    <TextBox x:Name="txtEmail" IsReadOnly="True" Background="#EEEEEE"/>
                    <TextBlock Text="Адрес" Margin="0,5,0,0"/>
                    <TextBox x:Name="txtAddress"/>
                    <Button Content="Сохранить" Margin="0,15,0,0" Click="btnSaveProfile_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>