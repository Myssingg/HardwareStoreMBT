<Window x:Class="HardwareStoreMBT.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рабочее место менеджера" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <TabControl BorderBrush="{StaticResource PrimaryPurple}">
            <TabItem Header="Заказы">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="cmbFilterStatus" 
                                  Width="150" 
                                  DisplayMemberPath="name" 
                                  SelectedValuePath="id"
                                  VerticalContentAlignment="Center"
                                  Height="35"/>
                        <Button Content="Фильтр" Width="80" Click="btnFilter_Click"/>
                        <Button Content="Все" Width="80" Click="btnAll_Click"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="dgOrders" AutoGenerateColumns="False" MouseDoubleClick="dgOrders_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding id}" Width="50"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding orderDateTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="130"/>
                            <DataGridTextColumn Header="Клиент" Binding="{Binding clients.surname}" Width="120"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding summ, StringFormat={}{0:C}}" Width="100"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding orderStatuses.name}" Width="120"/>
                            <DataGridTextColumn Header="Оплата" Binding="{Binding paymentStatuses.name}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="Сменить статус" Click="btnChangeStatus_Click"/>
                        <Button Content="Печать чека" Click="btnPrint_Click"/>
                        <Button Content="Обновить" Click="btnRefresh_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Клиенты">
                <Grid Margin="10">
                    <TextBox x:Name="txtClientSearch" 
                             Width="300" 
                             HorizontalAlignment="Left" 
                             TextChanged="txtClientSearch_TextChanged"
                             Height="35"
                             VerticalAlignment="Top"/>
                    <DataGrid x:Name="dgClients" Margin="0,45,0,0" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Фамилия" Binding="{Binding surname}" Width="*"/>
                            <DataGridTextColumn Header="Имя" Binding="{Binding name}" Width="*"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding phoneNumber}" Width="*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding email}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Товары">
                <DataGrid x:Name="dgProducts" Margin="10" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding name}" Width="*"/>
                        <DataGridTextColumn Header="Модель" Binding="{Binding model}" Width="*"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding price, StringFormat={}{0:C}}" Width="100"/>
                        <DataGridTextColumn Header="Остаток" Binding="{Binding stock}" Width="80"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding categories.name}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>