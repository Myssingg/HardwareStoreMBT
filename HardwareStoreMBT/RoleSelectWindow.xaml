<Window x:Class="HardwareStoreMBT.RoleSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор роли" Height="320" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Магазин бытовой техники" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryPurple}" Margin="0,0,0,30" HorizontalAlignment="Center"/>
            <Button x:Name="btnClient" Content="Я клиент" Width="220" Height="55" FontSize="16" Click="btnClient_Click"/>
            <Button x:Name="btnEmployee" Content="Я сотрудник" Width="220" Height="55" FontSize="16" Click="btnEmployee_Click"/>
        </StackPanel>
    </Grid>
</Window>