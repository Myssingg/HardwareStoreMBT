<Window x:Class="HardwareStoreMBT.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="385" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="25">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="tbTitle" Text="Вход" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryPurple}" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            <TextBlock x:Name="lblLogin" Text="Email / Логин" Foreground="{StaticResource DarkText}"/>
            <TextBox x:Name="txtLogin"/>
            <TextBlock Text="Пароль" Foreground="{StaticResource DarkText}" Margin="0,10,0,0"/>
            <PasswordBox x:Name="txtPassword"/>
            <Button x:Name="btnLogin" Content="Войти" Margin="0,20,0,0" Click="btnLogin_Click"/>

            <!--Регистрация-->
            <Button x:Name="btnRegister" Content="Нет аккаунта? Зарегистрироваться" 
                    Background="Transparent" Foreground="{StaticResource PrimaryPurple}"
                    BorderThickness="0" Click="btnRegister_Click"/>

            <TextBlock x:Name="tbError" Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>