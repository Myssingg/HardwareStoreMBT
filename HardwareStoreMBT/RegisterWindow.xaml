<Window x:Class="HardwareStoreMBT.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация клиента" Height="720" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Регистрация нового клиента" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryPurple}" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <TextBlock Text="Фамилия" Foreground="{StaticResource DarkText}"/>
            <TextBox x:Name="txtSurname"/>

            <TextBlock Text="Имя" Foreground="{StaticResource DarkText}" Margin="0,8,0,0"/>
            <TextBox x:Name="txtName"/>

            <TextBlock Text="Отчество" Foreground="{StaticResource DarkText}" Margin="0,8,0,0"/>
            <TextBox x:Name="txtPatronymic"/>

            <TextBlock Text="Телефон" Foreground="{StaticResource DarkText}" Margin="0,8,0,0"/>
            <TextBox x:Name="txtPhone"/>

            <TextBlock Text="Email" Foreground="{StaticResource DarkText}" Margin="0,8,0,0"/>
            <TextBox x:Name="txtEmail"/>

            <TextBlock Text="Пароль" Foreground="{StaticResource DarkText}" Margin="0,8,0,0"/>
            <PasswordBox x:Name="txtPassword"/>

            <TextBlock Text="Адрес" Foreground="{StaticResource DarkText}" Margin="0,8,0,0"/>
            <TextBox x:Name="txtAddress"/>

            <Button Content="Зарегистрироваться" Margin="0,15,0,5" Click="btnRegister_Click"/>
            <Button Content="Уже есть аккаунт" Background="#9E9E9E" Click="btnBack_Click"/>

            <TextBlock x:Name="tbError" Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>