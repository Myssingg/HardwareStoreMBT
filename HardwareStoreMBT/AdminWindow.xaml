<Window x:Class="HardwareStoreMBT.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель администратора" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <TabControl BorderBrush="{StaticResource PrimaryPurple}">
            <TabItem Header="Заказы">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="dgOrders" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding id}" Width="50"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding orderDateTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="130"/>
                            <DataGridTextColumn Header="Клиент" Binding="{Binding clients.surname}" Width="*"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding summ, StringFormat={}{0:C}}" Width="100"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding orderStatuses.name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="1" Content="Обновить" HorizontalAlignment="Left" Click="btnRefreshOrders_Click"/>
                </Grid>
            </TabItem>
            <TabItem Header="Товары">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="137*"/>
                        <ColumnDefinition Width="937*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0,0,0,591" Grid.RowSpan="2">
                        <Button Content="Добавить" Click="btnAddProduct_Click"/>
                        <Button Content="Изменить" Click="btnEditProduct_Click"/>
                        <Button Content="Удалить" Background="#D32F2F" Click="btnDeleteProduct_Click"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="dgProducts" AutoGenerateColumns="False" Grid.ColumnSpan="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding name}" Width="*"/>
                            <DataGridTextColumn Header="Модель" Binding="{Binding model}" Width="*"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding price, StringFormat={}{0:C}}" Width="100"/>
                            <DataGridTextColumn Header="Остаток" Binding="{Binding stock}" Width="80"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding categories.name}" Width="*"/>
                            <DataGridTextColumn Header="Производитель" Binding="{Binding manufacturers.name}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Актуален" Binding="{Binding relevanceStatuses.relevance}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Поставки">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Content="Новая поставка" HorizontalAlignment="Left" Click="btnAddSupply_Click"/>
                    <DataGrid Grid.Row="1" x:Name="dgSupplies" AutoGenerateColumns="False" SelectionChanged="dgSupplies_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding id}" Width="50"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding date, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                            <DataGridTextColumn Header="Поставщик" Binding="{Binding suppliers.name}" Width="*"/>
                            <DataGridTextColumn Header="Сотрудник" Binding="{Binding employees.surname}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid Grid.Row="2" x:Name="dgSupplyItems" AutoGenerateColumns="False" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товар" Binding="{Binding products.name}" Width="*"/>
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding productCount}" Width="80"/>
                            <DataGridTextColumn Header="Закупка" Binding="{Binding purchasePrice, StringFormat={}{0:C}}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Сотрудники">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Добавить" Click="btnAddEmp_Click"/>
                        <Button Content="Изменить" Click="btnEditEmp_Click"/>
                        <Button Content="Удалить" Background="#D32F2F" Click="btnDeleteEmp_Click"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="dgEmployees" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Логин" Binding="{Binding login}" Width="*"/>
                            <DataGridTextColumn Header="Фамилия" Binding="{Binding surname}" Width="*"/>
                            <DataGridTextColumn Header="Имя" Binding="{Binding name}" Width="*"/>
                            <DataGridTextColumn Header="Роль" Binding="{Binding roles.name}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Актуален" Binding="{Binding relevanceStatuses.relevance}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Справочники">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ComboBox x:Name="cmbRef" Width="200" HorizontalAlignment="Left" SelectionChanged="cmbRef_SelectionChanged">
                        <ComboBoxItem Content="Категории" Tag="categories"/>
                        <ComboBoxItem Content="Производители" Tag="manufacturers"/>
                        <ComboBoxItem Content="Поставщики" Tag="suppliers"/>
                        <ComboBoxItem Content="Роли" Tag="roles"/>
                        <ComboBoxItem Content="Способы оплаты" Tag="paymentMethods"/>
                        <ComboBoxItem Content="Статусы оплаты" Tag="paymentStatuses"/>
                        <ComboBoxItem Content="Статусы заказов" Tag="orderStatuses"/>
                    </ComboBox>
                    <DataGrid Grid.Row="1" x:Name="dgRef" AutoGenerateColumns="False" Margin="0,10,0,40" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="50"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding name}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Актуален" Binding="{Binding relevanceStatuses.relevance}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <Button Content="Добавить" Click="btnAddRef_Click"/>
                        <Button Content="Изменить" Click="btnEditRef_Click"/>
                        <Button Content="Удалить" Background="#D32F2F" Click="btnDeleteRef_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>